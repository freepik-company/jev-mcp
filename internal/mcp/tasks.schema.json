{
  "classify": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items",
      "categories",
      "instructions"
    ],
    "properties": {
      "items": {
        "$ref": "#/$defs/items"
      },
      "categories": {
        "type": "object",
        "minProperties": 2,
        "maxProperties": 128,
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "instructions": {
        "type": "string",
        "minLength": 1,
        "description": "Classification purpose and rules; include an explicit fallback category when appropriate."
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "description": "Optional System One model ID; defaults to the server configuration."
      }
    }
  },
  "verify": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "claims",
      "evidence"
    ],
    "properties": {
      "claims": {
        "$ref": "#/$defs/items"
      },
      "evidence": {
        "$ref": "#/$defs/items"
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "description": "Optional System One model ID; defaults to the server configuration."
      }
    }
  },
  "rerank": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query",
      "candidates"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      },
      "candidates": {
        "$ref": "#/$defs/items"
      },
      "top_k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64,
        "description": "Number of candidates to return; omit to return all. All candidates are scored."
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "description": "Optional System One model ID; defaults to the server configuration."
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  }
}
