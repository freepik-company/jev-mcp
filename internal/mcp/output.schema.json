{
  "type": "object",
  "required": ["model", "answers", "usage"],
  "properties": {
    "model": {"type": "string"},
    "answers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "choice", "confidence", "probabilities"],
            "properties": {
              "type": {"const": "choice"},
              "choice": {"type": "string"},
              "confidence": {"$ref": "#/$defs/probability"},
              "probabilities": {"$ref": "#/$defs/distribution"}
            }
          },
          {
            "type": "object",
            "required": ["type", "noul"],
            "properties": {"type": {"const": "noul"}, "noul": {"$ref": "#/$defs/probability"}}
          },
          {
            "type": "object",
            "required": ["type", "score", "confidence", "probabilities", "legend"],
            "properties": {
              "type": {"const": "score"},
              "score": {"type": "number", "minimum": 0},
              "confidence": {"$ref": "#/$defs/probability"},
              "probabilities": {"$ref": "#/$defs/distribution"},
              "legend": {"type": "object"}
            }
          }
        ]
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost": {"type": "number", "minimum": 0}
      },
      "description": "Provider usage unchanged, including cost when supplied."
    }
  },
  "$defs": {
    "probability": {"type": "number", "minimum": 0, "maximum": 1},
    "distribution": {"type": "object", "additionalProperties": {"$ref": "#/$defs/probability"}}
  }
}
